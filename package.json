{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:burgundy": "SITE_THEME=burgundy astro dev --ignore-lock",
    "dev:dragon": "SITE_THEME=dragon astro dev --ignore-lock",
    "dev:graphite": "SITE_THEME=graphite astro dev --ignore-lock",
    "dev:neon": "SITE_THEME=neon astro dev --ignore-lock",
    "dev:nord": "SITE_THEME=nord astro dev --ignore-lock",
    "dev:onedark": "SITE_THEME=onedark astro dev --ignore-lock",
    "dev:paper": "SITE_THEME=paper astro dev --ignore-lock",
    "dev:all": "node scripts/dev-all.mjs",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "build": "npm run check:contrast && astro build",
    "preview": "astro preview",
    "new:post": "node scripts/new-post.mjs",
    "test": "FIXTURE_POSTS=1 astro build && playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "astro": "^7.4.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

  {name === "email" && (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter">
      <rect x="2" y="4" width="20" height="16" />
      <polyline points="2,4 12,13 22,4" />
    </g>
  )}
  {name === "sun" && (
    <g fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="4" />
